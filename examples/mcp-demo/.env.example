# OpenAI API Key (required for chat)
OPENAI_API_KEY=sk-xxx

# MCP360 API Key (optional - for MCP360 gateway integration)
# Get your API key at https://mcp360.ai
# MCP360_API_KEY=your-mcp360-api-key

# MCP Server URL (defaults to local /api/mcp)
# Use MCP360: NEXT_PUBLIC_MCP_SERVER_URL=https://api.mcp360.ai/mcp
# NEXT_PUBLIC_MCP_SERVER_URL=/api/mcp
