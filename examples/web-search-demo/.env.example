# OpenAI API Key (required for LLM + enables native web search)
# This is all you need! OpenAI's built-in search will be used automatically.
OPENAI_API_KEY=sk-...

# ============================================
# OPTIONAL: Alternative Search Providers
# ============================================
# If you prefer a different search provider, uncomment one below.
# The app auto-detects which provider to use based on available keys.

# Google Native (uses Gemini's grounding - no extra API key needed)
# GOOGLE_API_KEY=...

# Third-party providers (require separate API key):
# TAVILY_API_KEY=tvly-...    # https://tavily.com/
# SERPER_API_KEY=...         # https://serper.dev/
# BRAVE_API_KEY=...          # https://brave.com/search/api/
# EXA_API_KEY=...            # https://exa.ai/
# SEARXNG_BASE_URL=...       # Self-hosted SearXNG instance
